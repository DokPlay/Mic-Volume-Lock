<Window x:Class="MicVolumeLock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mic Volume Lock"
        Width="1120"
        Height="720"
        MinWidth="980"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="24" Background="{DynamicResource AppBackground}" TextElement.Foreground="{DynamicResource TextPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText"
                           Text="Mic Volume Lock"
                           FontSize="25"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" />
                <TextBlock x:Name="SubtitleText"
                           Style="{StaticResource MutedText}"
                           Margin="0,4,0,0" />
            </StackPanel>
            <Border Grid.Column="1"
                    Background="{DynamicResource AccentSoftBrush}"
                    CornerRadius="18"
                    Padding="14,7"
                    VerticalAlignment="Center">
                <TextBlock x:Name="HeaderStatusText"
                           Foreground="{DynamicResource AccentBrush}"
                           FontWeight="SemiBold" />
            </Border>
        </Grid>

        <TabControl x:Name="MainTabs" Grid.Row="1" TabStripPlacement="Left">
            <TabItem x:Name="MicrophoneTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Section}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="DeviceSectionTitle" Style="{StaticResource SectionTitle}" />
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="DeviceCombo"
                                              DisplayMemberPath="DisplayName"
                                              SelectionChanged="DeviceCombo_OnSelectionChanged" />
                                    <Button x:Name="RefreshButton"
                                            Grid.Column="1"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="12,0,8,0"
                                            Click="RefreshButton_OnClick" />
                                    <Button x:Name="CopyEndpointIdButton"
                                            Grid.Column="2"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="0"
                                            Click="CopyEndpointIdButton_OnClick" />
                                </Grid>
                                <TextBlock x:Name="EndpointIdText"
                                           Grid.Row="2"
                                           Style="{StaticResource MutedText}"
                                           FontSize="12"
                                           Margin="0,10,0,0" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock x:Name="VolumeSectionTitle" Style="{StaticResource SectionTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="VolumeSlider"
                                            Minimum="0"
                                            Maximum="100"
                                            TickFrequency="1"
                                            SmallChange="1"
                                            IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center"
                                            ValueChanged="VolumeSlider_OnValueChanged" />
                                    <TextBox x:Name="VolumeText"
                                             Grid.Column="1"
                                             Margin="14,0,0,0"
                                             TextAlignment="Center"
                                             Text="85"
                                             TextChanged="VolumeText_OnTextChanged" />
                                    <TextBlock x:Name="DbHint"
                                               Grid.Column="2"
                                               Style="{StaticResource MutedText}"
                                               VerticalAlignment="Center"
                                               Margin="14,0,0,0" />
                                    <Button x:Name="ApplyButton"
                                            Grid.Column="3"
                                            MinWidth="110"
                                            Margin="14,0,0,0"
                                            Click="ApplyButton_OnClick" />
                                </Grid>
                                <CheckBox x:Name="LockCheck"
                                          Margin="0,16,0,0"
                                          FontWeight="SemiBold"
                                          Checked="LockCheck_OnChecked"
                                          Unchecked="LockCheck_OnChecked" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock x:Name="StatusSectionTitle" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="StatusText"
                                           Foreground="{DynamicResource TextPrimary}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="ControlText"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,8,0,0" />
                                <TextBlock x:Name="AgcText"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="SettingsTab">
                <StackPanel>
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock x:Name="SettingsSectionTitle" Style="{StaticResource SectionTitle}" />
                            <CheckBox x:Name="AutoStartCheck"
                                      Checked="AutoStartCheck_OnChecked"
                                      Unchecked="AutoStartCheck_OnChecked" />
                            <CheckBox x:Name="FollowDefaultCheck"
                                      Checked="FollowDefaultCheck_OnChecked"
                                      Unchecked="FollowDefaultCheck_OnChecked" />
                            <CheckBox x:Name="TryAgcCheck"
                                      Checked="TryAgcCheck_OnChecked"
                                      Unchecked="TryAgcCheck_OnChecked" />
                            <CheckBox x:Name="ShowNotificationsCheck"
                                      Checked="ShowNotificationsCheck_OnChecked"
                                      Unchecked="ShowNotificationsCheck_OnChecked" />
                            <CheckBox x:Name="DarkThemeCheck"
                                      Checked="DarkThemeCheck_OnChecked"
                                      Unchecked="DarkThemeCheck_OnChecked" />
                            <Button x:Name="PauseButton"
                                    Width="190"
                                    HorizontalAlignment="Left"
                                    Click="PauseButton_OnClick" />
                            <Button x:Name="ResetSettingsButton"
                                    Width="190"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,12,8,0"
                                    Click="ResetSettingsButton_OnClick" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <TabItem x:Name="LogTab">
                <Border Style="{StaticResource Section}">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                            <Button x:Name="OpenLogButton"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="OpenLogButton_OnClick" />
                            <Button x:Name="ClearLogViewButton"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="ClearLogViewButton_OnClick" />
                        </StackPanel>
                        <ListBox x:Name="LogList"
                                 Background="{DynamicResource LogBackground}"
                                 BorderBrush="{DynamicResource PanelBorder}"
                                 Foreground="{DynamicResource TextPrimary}"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 Padding="8" />
                    </DockPanel>
                </Border>
            </TabItem>

            <TabItem x:Name="ProfilesTab">
                <Border Style="{StaticResource Section}">
                    <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock x:Name="ProfileSectionTitle" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="ProfileHintText" Style="{StaticResource MutedText}" Margin="0,0,0,12" />
                        <TextBlock x:Name="ActiveProfileLabel" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
                        <ComboBox x:Name="ProfileCombo"
                                  Width="280"
                                  HorizontalAlignment="Left"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="ProfileCombo_OnSelectionChanged" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ProfileNameText"
                                     Grid.Column="0" />
                            <TextBox x:Name="ProfileVolumeText"
                                     Grid.Column="1"
                                     Margin="12,0,0,0"
                                     TextAlignment="Center" />
                            <CheckBox x:Name="ProfileLockCheck"
                                      Grid.Column="2"
                                      Margin="14,0,0,0" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="ApplyProfileButton" Click="ApplyProfileButton_OnClick" />
                            <Button x:Name="SaveCurrentProfileButton" Style="{StaticResource SecondaryButton}" Click="SaveCurrentProfileButton_OnClick" />
                            <Button x:Name="DeleteProfileButton" Style="{StaticResource SecondaryButton}" Click="DeleteProfileButton_OnClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem x:Name="HotkeysTab">
                <Border Style="{StaticResource Section}">
                    <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock x:Name="HotkeysSectionTitle" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="HotkeyHintText" Style="{StaticResource MutedText}" Margin="0,0,0,12" />
                        <CheckBox x:Name="HotkeysEnabledCheck"
                                  Checked="HotkeysEnabledCheck_OnChecked"
                                  Unchecked="HotkeysEnabledCheck_OnChecked" />
                        <TextBlock x:Name="HotkeyToggleText" Foreground="{DynamicResource TextPrimary}" Margin="0,8,0,0" />
                        <TextBlock x:Name="HotkeyUpText" Foreground="{DynamicResource TextPrimary}" Margin="0,6,0,0" />
                        <TextBlock x:Name="HotkeyDownText" Foreground="{DynamicResource TextPrimary}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem x:Name="DiagnosticsTab">
                <Border Style="{StaticResource Section}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="700" HorizontalAlignment="Left">
                            <TextBlock x:Name="DiagnosticsSectionTitle" Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="DiagnosticsHintText" Style="{StaticResource MutedText}" Margin="0,0,0,12" />
                            <TextBlock x:Name="ProcessLabelText" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="ProcessCombo"
                                          Width="280"
                                          DisplayMemberPath="ProcessName" />
                                <Button x:Name="RefreshProcessesButton"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="12,0,0,0"
                                        Click="RefreshProcessesButton_OnClick" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="IgnoreProcessButton" Click="IgnoreProcessButton_OnClick" />
                                <Button x:Name="StopIgnoringProcessButton" Style="{StaticResource SecondaryButton}" Click="StopIgnoringProcessButton_OnClick" />
                            </StackPanel>
                            <TextBlock x:Name="DiagnosticsLastEventText" Style="{StaticResource MutedText}" Margin="0,14,0,0" />
                            <TextBlock x:Name="SuspectsTitleText" Style="{StaticResource SectionTitle}" Margin="0,20,0,8" />
                            <TextBlock x:Name="DiscordHintText" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
                            <TextBlock x:Name="ZoomHintText" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
                            <TextBlock x:Name="SteamHintText" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
                            <TextBlock x:Name="WindowsExclusiveHintText" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
                            <TextBlock x:Name="NvidiaHintText" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
                            <TextBlock x:Name="AmdHintText" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <TabItem x:Name="HelpTab">
                <Border Style="{StaticResource Section}">
                    <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock x:Name="HelpSectionTitle" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="CopyLogButton" Click="CopyLogButton_OnClick" />
                            <Button x:Name="OpenLogsFolderButton" Style="{StaticResource SecondaryButton}" Click="OpenLogsFolderButton_OnClick" />
                            <Button x:Name="ExportSupportLogButton" Style="{StaticResource SecondaryButton}" Click="ExportSupportLogButton_OnClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem x:Name="UpdatesTab">
                <Border Style="{StaticResource Section}">
                    <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock x:Name="UpdatesSectionTitle" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="UpdatesHintText" Style="{StaticResource MutedText}" Margin="0,0,0,12" />
                        <Button x:Name="CheckUpdatesButton"
                                Width="190"
                                HorizontalAlignment="Left"
                                Click="CheckUpdatesButton_OnClick" />
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem x:Name="ThemeTab">
                <Border Style="{StaticResource Section}">
                    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock x:Name="ThemeSectionTitle" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="ThemeHintText"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,0,0,16" />
                        <RadioButton x:Name="LightThemeRadio"
                                     GroupName="AppTheme"
                                     Checked="LightThemeRadio_OnChecked" />
                        <RadioButton x:Name="DarkThemeRadio"
                                     GroupName="AppTheme"
                                     Checked="DarkThemeRadio_OnChecked" />
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem x:Name="LanguageTab">
                <Border Style="{StaticResource Section}">
                    <StackPanel MaxWidth="520" HorizontalAlignment="Left">
                        <TextBlock x:Name="LanguageSectionTitle" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="LanguageHintText"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,0,0,12" />
                        <ComboBox x:Name="LanguageCombo"
                                  Width="240"
                                  HorizontalAlignment="Left"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="LanguageCombo_OnSelectionChanged" />
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem x:Name="AboutTab">
                <Border Style="{StaticResource Section}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="AboutTitleText" Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="AboutTextBlock"
                                       Style="{StaticResource MutedText}"
                                       FontSize="13"
                                       LineHeight="19" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Window>

